    <string name="formula_desc_off_short">Sense càlcul automàtic</string>
    <string name="formula_desc_off_long">Aquest valor no es calcula automàticament. Podeu introduir-hi valors manualment.</string>
    <string name="bf_deurenberg_1991_short">Regressió clàssica per a adults</string>
    <string name="bf_deurenberg_1991_long">Una fórmula poblacional del 1991 molt utilitzada. Adequada per a poblacions d’adults en general; pot ser menys precisa en persones molt magres o molt musculars.</string>
    <string name="bf_deurenberg_1992_short">Ajustada per a adolescents i adults</string>
    <string name="bf_deurenberg_1992_long">Variant que s’adapta a usuaris més joves. És una estimació de propòsit general; els físics atlètics o atípics se’n poden desviar.</string>
    <string name="bf_eddy_1976_short">Model primerenc específic per sexe</string>
    <string name="bf_eddy_1976_long">Regressió antica amb coeficients separats per a homes i dones. Simple i ràpida, però no adaptada a poblacions especials.</string>
    <string name="bf_gallagher_2000_non_asian_short">Gallagher (no asiàtics)</string>
    <string name="bf_gallagher_2000_non_asian_long">Model de referència del 2000 per a persones no asiàtiques. Base útil; la precisió varia segons el tipus de cos.</string>
    <string name="bf_gallagher_2000_asian_short">Gallagher (asiàtics)</string>
    <string name="bf_gallagher_2000_asian_long">Model complementari ajustat a les persones asiàtiques. Utilitzeu-lo quan coincideixi millor amb el perfil de l’usuari.</string>
    <string name="bw_behnke_1963_short">Estimat d’ACT de Behnke</string>
    <string name="bw_behnke_1963_long">Estimació d’aigua corporal total clàssica. És una aproximació simple; no està individualitzada per a atletes o casos extrems.</string>
    <string name="bw_delwaide_crenier_1973_short">Delwaide i Crenier</string>
    <string name="bw_delwaide_crenier_1973_long">Fórmula d’ACT centrada en la massa corporal. És una estimació general raonable; la precisió varia segons el físic.</string>
    <string name="bw_hume_weyers_1971_short">ACT de Hume–Weyers</string>
    <string name="bw_hume_weyers_1971_long">Model d’ACT comú que utilitza l’alçada i el pes, amb coeficients específics per sexe.</string>
    <string name="bw_lee_song_kim_2001_short">Lee–Song–Kim</string>
    <string name="bw_lee_song_kim_2001_long">Estimació d’ACT posterior calibrada en cohorts coreanes. Considereu-la si coincideix amb l’usuari.</string>
    <string name="lbm_boer_1984_short">Massa magra de Boer (clínica)</string>
    <string name="lbm_boer_1984_long">Estimació de massa magra populars en entorns clínics. Regressió específica per sexe a partir de l’alçada i el pes.</string>
    <string name="lbm_hume_1966_short">Massa magra de Hume</string>
    <string name="lbm_hume_1966_long">Model primerenc de massa magra. Simple i utilitzat àmpliament; no adaptat a complexions molt atlètiques.</string>
    <string name="lbm_weight_minus_bf_short">Pes − Greix corporal</string>
    <string name="lbm_weight_minus_bf_long">Calcula la massa magra com al pes total menys la massa del greix derivada de la fórmula de greix corporal seleccionada. La precisió depèn de l’estimació del greix corporal.</string>
    <string name="bf_us_navy_short">Mètode de la Marina dels EUA</string>
    <string name="bf_us_navy_long">Calcula el percentatge de greix corporal a partir de les circumferències de la cintura, el coll i (en dones) els malucs segons l’estàndard de la Marina dels EUA.</string>
